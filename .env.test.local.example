# Playwright E2E — copy to .env.test.local (never commit).
# Specs auto-skip with a BLOCKED reason when these are missing.

# App URL under test (local: http://localhost:3000, live: https://matchpoin.vercel.app)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Supabase project used by the app under test
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Dedicated test accounts (never real users)
TEST_PLAYER_EMAIL=e2e-player@example.com
TEST_PLAYER_PASSWORD=replace-me
TEST_ADMIN_EMAIL=e2e-admin@example.com
TEST_ADMIN_PASSWORD=replace-me
# Optional third account for the two-player join/race tests
TEST_PLAYER2_EMAIL=e2e-player2@example.com
TEST_PLAYER2_PASSWORD=replace-me

# Optional: run Lighthouse in npm run verify:live
LIGHTHOUSE_BASE_URL=https://matchpoin.vercel.app
