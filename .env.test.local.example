# Playwright E2E — copy to .env.test.local (never commit).
# Specs auto-skip with a BLOCKED reason when these are missing.

PLAYWRIGHT_BASE_URL=http://localhost:3000

# Supabase project used by the app under test
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Dedicated test accounts (use accounts intended for testing only)
TEST_PLAYER_EMAIL=aabdiar@gmail.com
TEST_PLAYER_PASSWORD=replace-with-player-password
TEST_ADMIN_EMAIL=matchpoin.id@gmail.com
TEST_ADMIN_PASSWORD=replace-with-admin-password
TEST_PLAYER2_EMAIL=rizky.tennis@makassar.id
TEST_PLAYER2_PASSWORD=replace-with-player2-password

# Optional Lighthouse target
LIGHTHOUSE_BASE_URL=https://matchpoin.vercel.app
