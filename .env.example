# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Server-side only. Never expose this to the browser.
# Required to apply migrations and run privileged database jobs.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_or_service_role_key

# Supabase Storage bucket names (create these in Supabase Dashboard)
SUPABASE_STORAGE_AVATARS_BUCKET=avatars
SUPABASE_STORAGE_EVIDENCE_BUCKET=match-evidence
SUPABASE_STORAGE_TOURNAMENT_BUCKET=tournament-documents

# Client-visible bucket for match-result photos (compressed uploads).
NEXT_PUBLIC_SUPABASE_STORAGE_RESULTS_BUCKET=match-results

# App
# Alamat publik aplikasi. Dipakai sitemap.xml dan robots.txt.
# Di Vercel/production WAJIB diisi domain asli, bukan localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Makassar

# Direct Postgres connection (server-side only). Used by migration/backup scripts.
SUPABASE_DB_URL=postgresql://postgres:replace-me@db.your-project-id.supabase.co:5432/postgres?sslmode=require

# Absolute path OUTSIDE the repository for database backups.
MATCHPOIN_BACKUP_DIR=C:\matchpoin-backups

# MySQL (legacy rollback + one-time data import only; the app runs on Supabase)
DATABASE_URL=mysql://matchpoin_app:replace-me@127.0.0.1:3306/matchpoin

# Admin seed (scripts/supabase/seed-admin.mjs). The password is hashed by
# Supabase Auth; never commit a real value. Keep this file value empty.
ADMIN_EMAIL=matchpoin.id@gmail.com
ADMIN_PASSWORD=

# One-time Super Admin bootstrap (scripts/mysql/bootstrap-super-admin.mjs).
# Set only for the bootstrap run in .env.local, then remove it. Never commit a real value.
MATCHPOIN_BOOTSTRAP_SECRET=

# OAuth (configure providers in Supabase Dashboard → Authentication → Providers)
# Redirect URL to register with Google/Facebook:
#   http://localhost:3000/auth/callback  (development)
#   https://your-domain.com/auth/callback (production)
# Supabase callback (for provider console):
#   https://<project-ref>.supabase.co/auth/v1/callback

# SMTP Configuration (for password reset emails if not using Supabase Auth email)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=noreply@yourdomain.com
# SMTP_SECURE=false

# Public contact for Privacy Policy / Terms / Meta data-deletion URL
NEXT_PUBLIC_CONTACT_EMAIL=matchpoin.id@gmail.com

# WhatsApp gateway (opsional). Dipakai untuk mengirim notifikasi WA ke lawan
# ketika seorang host membuat tantangan tanding.
# Tanpa nilai di bawah, pengiriman dilewati dan alur aplikasi tetap berjalan.
#   WHATSAPP_API_STYLE=form  -> Fonnte (FormData: target, message)
#   WHATSAPP_API_STYLE=json  -> Wablas / gateway generik (JSON: phone, message)
# WHATSAPP_API_URL=https://api.fonnte.com/send
# WHATSAPP_API_TOKEN=your_gateway_token
# WHATSAPP_API_STYLE=form
