# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Server-side only. Never expose this to the browser.
# Required to apply migrations and run privileged database jobs.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_or_service_role_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Makassar

# OAuth (configure providers in Supabase Dashboard → Authentication → Providers)
# Redirect URL to register with Google/Facebook:
#   http://localhost:3000/auth/callback  (development)
#   https://your-domain.com/auth/callback (production)
# Supabase callback (for provider console):
#   https://<project-ref>.supabase.co/auth/v1/callback